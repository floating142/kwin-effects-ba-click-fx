msgid "Overall scaling:"
msgstr "整體縮放："

msgid "Enable per-display scaling"
msgstr "啟用顯示器獨立縮放"

msgid "Reset to 1.00"
msgstr "還原為 1.00"

msgid "Global"
msgstr "全域"

msgid "Time scale:"
msgstr "時間縮放："

msgid "Below 1 slows down, above 1 speeds up the effect"
msgstr "小於 1 會放慢，大於 1 會加快整套特效"

msgid "Scale all elements"
msgstr "縮放所有元素"

msgid "Trail"
msgstr "拖尾"

msgid "Enable trail"
msgstr "啟用拖尾"

msgid "Show a ribbon while dragging with the left button"
msgstr "按住滑鼠左鍵拖曳時顯示帶狀光效"

msgid "Always show trail"
msgstr "始終顯示拖尾"

msgid "Show trail during pointer movement; may increase GPU usage"
msgstr "游標移動時持續顯示拖尾，可能會增加 GPU 使用量"

msgid "Enable distance particles"
msgstr "啟用沿途粒子"

msgid "Emit triangles by traveled distance"
msgstr "依照拖曳距離發射三角形粒子"

msgid "Show debug options"
msgstr "顯示除錯選項"

msgid "Show logging, damage and diagnostics controls"
msgstr "顯示日誌、重繪區域及診斷控制項"

msgid "Log level:"
msgstr "日誌等級："

msgid "Off"
msgstr "關閉"

msgid "Errors"
msgstr "錯誤"

msgid "Instances"
msgstr "實例"

msgid "Frame stats"
msgstr "影格統計"

msgid "Verbose"
msgstr "詳細除錯"

msgid "Show damage borders"
msgstr "顯示重繪區域邊框"

msgid "Show requested regions; disable for performance tests"
msgstr "顯示特效要求的重繪區域；進行效能測試時請停用"

msgid "Copy diagnostics"
msgstr "複製診斷資訊"

msgid "Copy plugin, GPU, output and resource status"
msgstr "複製外掛程式、GPU、輸出及資源狀態"

msgid "Generate report"
msgstr "產生報告"

msgid "Save status and recent logs to the diagnostics cache"
msgstr "將目前狀態與近期日誌儲存至診斷快取"

msgid "Open diagnostics folder"
msgstr "開啟診斷資料夾"

msgid "Open the diagnostics cache folder"
msgstr "開啟診斷快取資料夾"

msgid "Copied"
msgstr "已複製"

msgid "Failed"
msgstr "失敗"

msgid "Generated"
msgstr "已產生"

msgid "Only trigger on desktop clicks"
msgstr "僅在點擊桌面時觸發"

msgid "Restrict the effect to clicks on the desktop background (wallpaper). Clicks on windows, panels, and other UI elements won't trigger it."
msgstr "僅當點擊桌面背景（桌布）時觸發效果；點擊視窗、面板或其他介面元素時不會觸發。"

msgid "Exclude specified applications"
msgstr "排除指定應用程式"

msgid "Do not trigger the effect when clicking applications in the exclusion list"
msgstr "點擊排除清單中的應用程式時不觸發效果"

msgid "Excluded applications"
msgstr "已排除的應用程式"

msgid "Pick a window to exclude every window belonging to the same application."
msgstr "選取一個視窗，排除屬於同一應用程式的所有視窗。"

msgid "Application"
msgstr "應用程式"

msgid "Identifier"
msgstr "識別碼"

msgid "Pick window…"
msgstr "選取視窗…"

msgid "Remove"
msgstr "移除"

msgid "Click a window…"
msgstr "請點擊視窗…"

msgid "Window selection failed"
msgstr "視窗選取失敗"

msgid "Application cannot be identified"
msgstr "無法識別應用程式"

msgid "The selected window does not provide a stable application identifier."
msgstr "所選視窗未提供穩定的應用程式識別碼。"

msgid "Application already excluded"
msgstr "應用程式已被排除"

msgid "This application is already in the exclusion list."
msgstr "此應用程式已在排除清單中。"

msgid "Exclude all windows belonging to %1?\n\nApplication identifier: %2"
msgstr "要排除屬於 %1 的所有視窗嗎？\n\n應用程式識別碼：%2"

msgid "Exclude application"
msgstr "排除應用程式"

msgid "Exclude"
msgstr "排除"
