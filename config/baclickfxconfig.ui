       </item>
       <item>
        <widget class="QCheckBox" name="desktopOnlyCheckBox">
         <property name="text">
          <string>Only show effect on desktop</string>
         </property>
         <property name="toolTip">
          <string>Restrict the whole effect, including the trail, to the desktop background (wallpaper). Windows, panels and other UI elements won't trigger it.</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="excludeApplicationsCheckBox">
         <property name="text">
          <string>Exclude specified applications</string>
         </property>
