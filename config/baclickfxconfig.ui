<!--
  BA Click FX 配置界面。

  QSlider 仅支持整数，因此带小数的倍率统一放大 100 倍存放，并由
  baclickfxconfig.cpp 在读写界面时换算。界面只提供平台偏好和功能开关；
  Unity 数据确定的视觉参数不作为用户配置项。
-->
<ui version="4.0">
 <class>BaClickFxEffectConfigForm</class>
 <widget class="QWidget" name="BaClickFxEffectConfigForm">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>520</width>
    <height>300</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">

   <!-- 全局设置 -->
   <item>
    <widget class="QGroupBox" name="globalGroupBox">
     <property name="title">
      <string>Global</string>
     </property>
     <layout class="QFormLayout" name="globalFormLayout">

      <item row="0" column="0">
       <widget class="QLabel" name="timeScaleLabel">
        <property name="text">
         <string>Time scale:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <layout class="QHBoxLayout" name="timeScaleLayout">
        <item>
         <widget class="QSlider" name="timeScaleSlider">
          <property name="minimum">
           <number>20</number>
          </property>
          <property name="maximum">
           <number>500</number>
          </property>
          <property name="value">
           <number>100</number>
          </property>
          <property name="orientation">
           <enum>Qt::Horizontal</enum>
          </property>
          <property name="toolTip">
           <string>Below 1 slows down, above 1 speeds up the effect</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="timeScaleValueLabel">
          <property name="text">
           <string>1.00</string>
          </property>
          <property name="minimumWidth">
           <number>40</number>
          </property>
         </widget>
        </item>
       </layout>
      </item>

      <item row="1" column="0">
       <widget class="QLabel" name="globalScaleLabel">
        <property name="text">
         <string>Overall size:</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <layout class="QHBoxLayout" name="globalScaleLayout">
        <item>
         <widget class="QSlider" name="globalScaleSlider">
          <property name="minimum">
           <number>50</number>
          </property>
          <property name="maximum">
           <number>500</number>
          </property>
          <property name="value">
           <number>100</number>
          </property>
          <property name="orientation">
           <enum>Qt::Horizontal</enum>
          </property>
          <property name="toolTip">
           <string>Scale all elements</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="globalScaleValueLabel">
          <property name="text">
           <string>1.00</string>
          </property>
          <property name="minimumWidth">
           <number>40</number>
          </property>
         </widget>
        </item>
       </layout>
      </item>

     </layout>
    </widget>
   </item>

   <!-- 拖尾设置 -->
   <item>
    <widget class="QGroupBox" name="trailGroupBox">
     <property name="title">
      <string>Trail</string>
     </property>
     <layout class="QFormLayout" name="trailFormLayout">

      <item row="0" column="0" colspan="2">
       <widget class="QCheckBox" name="enableTrailCheckBox">
        <property name="text">
         <string>Enable trail</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="toolTip">
         <string>Show a ribbon while dragging with the left button</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0" colspan="2">
       <widget class="QCheckBox" name="alwaysTrailCheckBox">
        <property name="text"><string>Always show trail</string></property>
        <property name="toolTip"><string>Show trail during pointer movement; may increase GPU usage</string></property>
       </widget>
      </item>
      <item row="2" column="0" colspan="2">
       <widget class="QCheckBox" name="enableDistanceEmitterCheckBox">
        <property name="text"><string>Enable distance particles</string></property>
        <property name="checked"><bool>true</bool></property>
        <property name="toolTip"><string>Emit triangles by traveled distance</string></property>
       </widget>
      </item>

     </layout>
    </widget>
   </item>

   <!-- 调试选项 -->
   <item>
    <widget class="QCheckBox" name="showDebugOptionsCheckBox">
     <property name="text"><string>Show debug options</string></property>
     <property name="toolTip"><string>Show logging, damage and diagnostics controls</string></property>
    </widget>
   </item>

   <item>
    <layout class="QHBoxLayout" name="logLevelLayout">
     <item>
      <widget class="QLabel" name="logLevelLabel">
       <property name="text"><string>Log level:</string></property>
      </widget>
     </item>
     <item>
       <widget class="QComboBox" name="logLevelComboBox">
       <item><property name="text"><string>Off</string></property></item>
       <item><property name="text"><string>Errors</string></property></item>
       <item><property name="text"><string>Instances</string></property></item>
       <item><property name="text"><string>Frame stats</string></property></item>
       <item><property name="text"><string>Verbose</string></property></item>
      </widget>
     </item>
    </layout>
   </item>

   <item>
    <widget class="QCheckBox" name="debugDamageCheckBox">
     <property name="text">
      <string>Show damage borders</string>
     </property>
     <property name="toolTip">
      <string>Show requested regions; disable for performance tests</string>
     </property>
    </widget>
   </item>

   <item>
   <widget class="QPushButton" name="copyDiagnosticsButton">
     <property name="text">
      <string>Copy diagnostics</string>
     </property>
     <property name="toolTip">
       <string>Copy plugin, GPU, output and resource status</string>
     </property>
   </widget>
  </item>

   <item>
    <widget class="QPushButton" name="generateDiagnosticsButton">
     <property name="text"><string>Generate report</string></property>
     <property name="toolTip"><string>Save status and recent logs to the diagnostics cache</string></property>
    </widget>
   </item>

   <item>
    <widget class="QPushButton" name="openDiagnosticsDirButton">
     <property name="text">
      <string>Open diagnostics folder</string>
     </property>
     <property name="toolTip">
      <string>Open the diagnostics cache folder</string>
     </property>
    </widget>
   </item>

   <item>
    <spacer name="verticalSpacer">
     <property name="orientation">
      <enum>Qt::Vertical</enum>
     </property>
     <property name="sizeHint" stdset="0">
      <size>
       <width>20</width>
       <height>20</height>
      </size>
     </property>
    </spacer>
   </item>

  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
