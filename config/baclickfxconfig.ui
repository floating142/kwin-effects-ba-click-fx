           <item>
            <widget class="QGroupBox" name="globalGroupBox">
             <property name="title">
              <string>Timing and scale</string>
             </property>
             <layout class="QFormLayout" name="globalFormLayout">
              <item row="0" column="0">
               <widget class="QLabel" name="timeScaleLabel">
                <property name="text">
                 <string>Time scale:</string>
                </property>
               </widget>
              </item>
              <item row="0" column="1">
               <layout class="QHBoxLayout" name="timeScaleLayout">
                <item>
                 <widget class="QSlider" name="timeScaleSlider">
                  <property name="minimum">
                   <number>20</number>
                  </property>
                  <property name="maximum">
                   <number>500</number>
                  </property>
                  <property name="value">
                   <number>100</number>
                  </property>
                  <property name="orientation">
                   <enum>Qt::Horizontal</enum>
                  </property>
                  <property name="toolTip">
                   <string>Below 1 slows down, above 1 speeds up the effect</string>
                  </property>
                 </widget>
                </item>
                <item>
                 <widget class="QLabel" name="timeScaleValueLabel">
                  <property name="text">
                   <string>1.00</string>
