        <number>12</number>
       </property>
       <item>
        <widget class="QCheckBox" name="enableClickCheckBox">
         <property name="text">
          <string>Enable click effect</string>
         </property>
         <property name="checked">
          <bool>true</bool>
         </property>
         <property name="toolTip">
          <string>Play the click burst on mouse press. The trail and distance particles are not affected.</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="triggerButtonsGroupBox">
         <property name="title">
          <string>Trigger buttons</string>
         </property>
         <property name="toolTip">
          <string>Select any combination for clicks and held trails. Always show trail works independently.</string>
         </property>
         <layout class="QHBoxLayout" name="triggerButtonsLayout">
          <item>
           <widget class="QCheckBox" name="leftButtonCheckBox">
            <property name="text">
             <string>Left button</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="rightButtonCheckBox">
            <property name="text">
             <string>Right button</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="middleButtonCheckBox">
            <property name="text">
             <string>Middle button</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="trailGroupBox">
         <property name="title">
          <string>Trail</string>
         </property>
         <layout class="QFormLayout" name="trailFormLayout">
          <item row="0" column="0" colspan="2">
           <widget class="QCheckBox" name="enableTrailCheckBox">
            <property name="text">
             <string>Enable trail</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
            <property name="toolTip">
             <string>Show a ribbon while dragging with the selected trigger buttons</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0" colspan="2">
           <widget class="QCheckBox" name="alwaysTrailCheckBox">
            <property name="text">
             <string>Always show trail</string>
            </property>
            <property name="toolTip">
             <string>Show trail during pointer movement; may increase GPU usage</string>
            </property>
           </widget>
          </item>
          <item row="2" column="0" colspan="2">
           <widget class="QCheckBox" name="enableDistanceEmitterCheckBox">
            <property name="text">
             <string>Enable distance particles</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
            <property name="toolTip">
             <string>Emit triangles by traveled distance</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
